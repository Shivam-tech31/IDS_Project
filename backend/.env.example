# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/ids_db?retryWrites=true&w=majority

# Set to true to enable email/SMS alerts
NOTIFICATIONS_ENABLED=false

# Gmail credentials for email alerts
ALERT_EMAIL=your_gmail@gmail.com
ALERT_EMAIL_PASSWORD=your_app_password
ALERT_RECEIVER=receiver@gmail.com

# Fast2SMS API key for SMS (free Indian SMS API)
FAST2SMS_KEY=your_fast2sms_api_key
SMS_RECEIVER=9999999999

# CORS origin — set to your Vercel frontend URL in production
FRONTEND_URL=http://localhost:5173
